<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family Guard Setup"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5" />

        <Button
            android:id="@+id/btn_usage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Usage Access"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_device_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Device Admin"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Protection"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/input_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter pairing code"
            android:layout_marginTop="24dp"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bind to parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Status: idle" />
    </LinearLayout>
</ScrollView>
